<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Back to macros"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Macro settings"
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettingsSave"
            android:layout_width="76dp"
            android:layout_height="44dp"
            android:backgroundTint="#3B82F6"
            android:minWidth="0dp"
            android:text="Save"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                style="@style/SettingsLabel"
                android:text="Name" />

            <EditText
                android:id="@+id/etSettingsName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#3B82F6"
                android:hint="Macro name"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="40"
                android:singleLine="true"
                android:textColor="#F1F5F9"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSettingsNameCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/40"
                android:textColor="#64748B"
                android:textSize="9sp" />

            <TextView
                style="@style/SettingsLabel"
                android:text="Speed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSettingsSpeedDown"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Slower"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_minus" />

                <TextView
                    android:id="@+id/tvSettingsSpeed"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1.0x"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnSettingsSpeedUp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Faster"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_plus" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/speedPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                style="@style/SettingsLabel"
                android:text="Repeat" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRepeatOnce"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:minWidth="0dp"
                    android:text="Once"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnRepeatLoop"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:minWidth="0dp"
                    android:text="Loop"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnRepeatCustom"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:minWidth="0dp"
                    android:text="Custom"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etRepeatCount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#3B82F6"
                android:hint="Runs (1-9999)"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:singleLine="true"
                android:textColor="#F1F5F9"
                android:textColorHint="#64748B"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                style="@style/SettingsLabel"
                android:text="Delay between repeats (seconds)" />

            <EditText
                android:id="@+id/etDelay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#3B82F6"
                android:hint="0.8"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:singleLine="true"
                android:textColor="#F1F5F9"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/delayPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                style="@style/SettingsLabel"
                android:text="Start countdown (seconds)" />

            <EditText
                android:id="@+id/etCountdown"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#3B82F6"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2"
                android:singleLine="true"
                android:textColor="#F1F5F9"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/countdownPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                style="@style/SettingsLabel"
                android:text="Stop conditions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Switch
                    android:id="@+id/swStopOnBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="Stop when Clash leaves the foreground" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Stop when Clash leaves the foreground"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Switch
                    android:id="@+id/swStopMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="Stop after minutes" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Stop after minutes"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etStopMinutes"
                    android:layout_width="76dp"
                    android:layout_height="44dp"
                    android:backgroundTint="#3B82F6"
                    android:gravity="end"
                    android:hint="30"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:singleLine="true"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Switch
                    android:id="@+id/swStopAttacks"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="Stop after attacks" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Stop after attacks"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etStopAttacks"
                    android:layout_width="76dp"
                    android:layout_height="44dp"
                    android:backgroundTint="#3B82F6"
                    android:gravity="end"
                    android:hint="10"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:singleLine="true"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Switch
                    android:id="@+id/swPinned"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="Pin to top" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Pin to top"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDuplicate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:minWidth="0dp"
                    android:text="Duplicate"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnResetDefaults"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:minWidth="0dp"
                    android:text="Reset"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnDeleteMacro"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7F1D1D"
                    android:minWidth="0dp"
                    android:text="Delete"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSettingsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvSettingsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F87171"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
