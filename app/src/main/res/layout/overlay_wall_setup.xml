<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/setupFrameImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <com.clahbot.overlay.WallLineView
        android:id="@+id/setupLines"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/setupMarkerA"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_marker_a"
        android:elevation="6dp"
        android:gravity="center"
        android:text="A"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/setupMarkerB"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_marker_b"
        android:elevation="6dp"
        android:gravity="center"
        android:text="B"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/setupBannerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/bg_setup_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvSetupBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Set wall line — Drag the green marker to the FIRST wall and the red marker to the LAST wall"
            android:textColor="#E6EBF5"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/setupPickerScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_setup_panel"
        android:padding="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/setupPickerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/setupReserveRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_setup_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep at least"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSetupReserveGold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gold · 2,000,000"
                android:textColor="#E6EBF5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnResGoldMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="−"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnResGoldPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="+"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSetupReserveElixir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Elixir · 2,000,000"
                android:textColor="#E6EBF5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnResElixirMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="−"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnResElixirPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="+"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Run when you reach"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSetupThresholdGold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gold · 9,000,000"
                android:textColor="#E6EBF5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnThrGoldMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="−"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnThrGoldPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="+"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSetupThresholdElixir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Elixir · 9,000,000"
                android:textColor="#E6EBF5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnThrElixirMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="−"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnThrElixirPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="+"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Spend caps · 0 means no cap"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSetupCapSession"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="This session · none"
                android:textColor="#E6EBF5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCapSessionMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="−"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnCapSessionPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="+"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSetupCapDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Per day · none"
                android:textColor="#E6EBF5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCapDayMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="−"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnCapDayPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="+"
                android:textColor="#E6EBF5"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSetupReserveDone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#2563EB"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setupBottomBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_setup_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvSetupHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Taps are spread along the line. Walls are upgraded from A towards B."
            android:textColor="#9FB0CF"
            android:textSize="10.5sp" />

        <LinearLayout
            android:id="@+id/setupLineTotals"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSetupTotalWalls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Walls in line · 120"
                android:textColor="#E6EBF5"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSetupTotalMinus"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="−"
                android:textColor="#E6EBF5"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnSetupTotalPlus"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="+"
                android:textColor="#E6EBF5"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSetupDoneWalls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Already at max · 0"
                android:textColor="#E6EBF5"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSetupDoneMinus"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="−"
                android:textColor="#E6EBF5"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnSetupDonePlus"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_save_input"
                android:gravity="center"
                android:text="+"
                android:textColor="#E6EBF5"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSetupCancel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#E6EBF5"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btnSetupSave"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#2563EB"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Save line"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
