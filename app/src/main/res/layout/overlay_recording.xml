<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <LinearLayout
        android:id="@+id/recordingPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#CC1A1A2E"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvRecordingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Recording"
            android:textColor="#F44336"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRecordingSteps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Steps: 0"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRecordingPause"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FF9800"
            android:paddingHorizontal="12dp"
            android:text="Pause"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRecordingFinish"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#4CAF50"
            android:paddingHorizontal="12dp"
            android:text="Finish"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRecordingCancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#F44336"
            android:paddingHorizontal="12dp"
            android:text="Cancel"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
