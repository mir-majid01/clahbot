<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallPickerRoot"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wall upgrade macros"
        android:textColor="#E6EBF5"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Choose the macro that opens a wall and upgrades it."
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/wallPickerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnWallPickerClose"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#1B2742"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="#E6EBF5"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
