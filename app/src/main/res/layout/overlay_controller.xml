<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controllerRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/controllerHeader"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_autoclash_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/app_name"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ready"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Minimize controller"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minimize" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Close controller"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/pageTabs"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPageController"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Controller"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnPageStats"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Stats"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- READY -->
            <LinearLayout
                android:id="@+id/readyPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#DC2626"
                    android:text="●  Record"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecordMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Live relay · game responds"
                    android:textColor="#22C55E"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvLibraryLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Macros"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <ScrollView
                    android:id="@+id/macroScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxHeight="148dp">

                    <LinearLayout
                        android:id="@+id/macroList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="#3B82F6"
                        android:text="▶  Play"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnRename"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="Rename macro"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_edit" />

                    <ImageButton
                        android:id="@+id/btnDelete"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="Delete macro"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_delete" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speed"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <ImageButton
                        android:id="@+id/btnSpeedDown"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="Slower"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_minus" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="46dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1.0x"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnSpeedUp"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="Faster"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_plus" />

                    <Button
                        android:id="@+id/btnRepeat"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1E293B"
                        android:text="Once"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- RECORDING -->
            <LinearLayout
                android:id="@+id/recordingPanel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_recording"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_rec_dot" />

                <TextView
                    android:id="@+id/tvRecState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="REC"
                    android:textColor="#FECACA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRecPause"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:backgroundTint="#F59E0B"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="Pause"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnRecFinish"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#22C55E"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="Finish"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- REVIEW -->
            <LinearLayout
                android:id="@+id/reviewPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvReviewInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recording review"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRecordAgain"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="#334155"
                        android:text="Again"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnDiscard"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#64748B"
                        android:text="Discard"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#22C55E"
                        android:text="Save"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- PLAYING -->
            <LinearLayout
                android:id="@+id/playingPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPlayingName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Macro"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Playing"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPlayPause"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="#F59E0B"
                        android:text="Pause"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStopPlayback"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#DC2626"
                        android:text="■  Stop"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPlayingSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Speed 1.0x"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvPlayingRepeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Once"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/statsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="300dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatsState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Idle"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="No attack in progress"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvStatsTotals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Attacks 0"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvStatsTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvStatsRecent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text=""
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bubble"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_bubble"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_autoclash_mark" />

        <TextView
            android:id="@+id/bubbleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="3dp"
            android:text=""
            android:textColor="#FCA5A5"
            android:textSize="7sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
