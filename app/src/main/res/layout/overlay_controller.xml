<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controllerRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/controllerHeader"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ClahBOT"
                android:textColor="#4CAF50"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvControllerStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ready"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnMinimize"
                android:layout_width="34dp"
                android:layout_height="28dp"
                android:backgroundTint="#37474F"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="—"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCloseController"
                android:layout_width="34dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#F44336"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="✕"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#4CAF50"
                android:text="Record"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnStopRecording"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#F44336"
                android:text="Stop Rec"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#2196F3"
                android:text="▶ Play"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9800"
                android:text="Pause"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnStopPlayback"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#E53935"
                android:text="■ Stop"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLoop"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:backgroundTint="#00897B"
                android:text="Loop: On"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnSpeedDown"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#455A64"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="−"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSpeedUp"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:backgroundTint="#455A64"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/saveRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:backgroundTint="#4CAF50"
                android:text="Save Macro"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnDiscard"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#607D8B"
                android:text="Discard"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecordingCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#FFCDD2"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Saved Macros"
            android:textColor="#AAAAAA"
            android:textSize="10sp" />

        <ScrollView
            android:id="@+id/macroScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxHeight="150dp">

            <LinearLayout
                android:id="@+id/macroList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRename"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:backgroundTint="#5E35B1"
                android:text="Rename"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#B71C1C"
                android:text="Delete"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bubble"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_bubble"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="CB"
            android:textColor="#4CAF50"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubbleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:text=""
            android:textColor="#FFCDD2"
            android:textSize="8sp" />
    </FrameLayout>
</FrameLayout>
