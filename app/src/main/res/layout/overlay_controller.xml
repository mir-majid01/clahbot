<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controllerRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/controllerHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_autoclash_mark" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_status_dot" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/pageTabs"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnPageController"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Controller"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPageStats"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Stats"
                    android:textColor="#9FB0CF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Minimize controller"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minimize" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Close controller"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#9FB0CF"
            android:textSize="10sp"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <!-- READY -->
            <LinearLayout
                android:id="@+id/readyPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:backgroundTint="#DC2626"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="●  Record"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecordMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Passive · game responds"
                    android:textColor="#4ADE80"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/undoRow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#1E293B"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvUndoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Macro deleted"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnUndo"
                        android:layout_width="72dp"
                        android:layout_height="44dp"
                        android:backgroundTint="#3B82F6"
                        android:minWidth="0dp"
                        android:text="Undo"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLibraryLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Macros"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <ScrollView
                    android:id="@+id/macroScroll"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="3dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/macroList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- RECORDING -->
            <LinearLayout
                android:id="@+id/recordingPanel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_recording"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_rec_dot" />

                <TextView
                    android:id="@+id/tvRecState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="REC"
                    android:textColor="#FECACA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRecPause"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:backgroundTint="#F59E0B"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="Pause"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnRecFinish"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#22C55E"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="Finish"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- REVIEW -->
            <LinearLayout
                android:id="@+id/reviewPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvReviewInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recording review"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRecordAgain"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="#334155"
                        android:text="Again"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnDiscard"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#64748B"
                        android:text="Discard"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#22C55E"
                        android:text="Save"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- PLAYING -->
            <LinearLayout
                android:id="@+id/playingPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPlayingName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Macro"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="Playing"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPlayPause"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="#F59E0B"
                        android:text="Pause"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStopPlayback"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#DC2626"
                        android:text="■  Stop"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPlayingSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Speed 1.0x"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvPlayingRepeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Once"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/statsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/statsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/countdownPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStartCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="#F1F5F9"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Switch to Clash of Clans"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnStopCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Stop"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/settingsHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bubble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/bubbleVisual"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_bubble">

            <ImageView
                android:id="@+id/bubbleIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_autoclash_mark" />

            <TextView
                android:id="@+id/bubbleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:text=""
                android:textColor="#FCA5A5"
                android:textSize="6sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
